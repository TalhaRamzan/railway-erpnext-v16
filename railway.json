{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/**", "!/mariadb/**", "!/*.md"]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/api/method/ping",
    "healthcheckTimeout": 900,
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false,
    "drainingSeconds": 30
  }
}
