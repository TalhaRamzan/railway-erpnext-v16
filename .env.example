# Copy to .env for LOCAL testing with docker compose. Never commit .env.
# On Railway these are set per service (see railway-template.md); passwords
# there come from ${{secret(...)}} and service references, not from this file.

# --- Required ---------------------------------------------------------------
# MariaDB root password (Railway: MARIADB_ROOT_PASSWORD on the MariaDB service)
DB_ROOT_PASSWORD=
# Redis password (Railway's Redis service generates its own)
REDIS_PASSWORD=
# Administrator password for the new site. Used ONLY on the very first boot.
ADMIN_PASSWORD=

# --- Site -------------------------------------------------------------------
# Internal site name. Never change it after the first boot.
SITE_NAME=erp.local
# Public base URL used in emails/print links. On Railway this defaults to
# https://$RAILWAY_PUBLIC_DOMAIN; set it when you add a custom domain.
FRAPPE_HOST_NAME=http://localhost:8080
LOCAL_PORT=8080

# --- Size / RAM -------------------------------------------------------------
# Each gunicorn worker is roughly 150-250 MB. 1 worker x 4 threads suits ~1-10 users.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# --- Nightly backups (to the volume) ----------------------------------------
BACKUP_ENABLED=true
# HH:MM in UTC
BACKUP_TIME=02:00
# Local backups kept on the volume
BACKUP_KEEP=3
BACKUP_WITH_FILES=true

# --- Optional off-site copy to any S3-compatible bucket (restic) ------------
# e.g. s3:https://<accountid>.r2.cloudflarestorage.com/<bucket>/erpnext
#      s3:https://s3.us-east-1.amazonaws.com/<bucket>/erpnext
BACKUP_S3_REPOSITORY=
# Encryption password for the backup repository. Store a copy somewhere safe:
# without it the off-site backups cannot be read.
BACKUP_S3_PASSWORD=
BACKUP_S3_KEEP=14
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
